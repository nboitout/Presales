ANTHROPIC_API_KEY=sk-ant-...
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Comma-separated emails allowed to sign in to the rep workspace. When set,
# this is the ONLY gate (so a personal Gmail works). Leave empty to instead
# allow any non-consumer/professional email domain.
ALLOWED_EMAILS=you@yourfirm.com
BLOB_READ_WRITE_TOKEN=
POSTGRES_URL=

# Passwordless magic-link email (prospect sign-in). If RESEND_API_KEY is unset,
# the link is logged to the server console (and shown in the UI in dev).
RESEND_API_KEY=
EMAIL_FROM="Agentic SDLC <advisor@yourdomain.com>"

# Shown to prospects as the contact for data deletion / consent withdrawal.
PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com
