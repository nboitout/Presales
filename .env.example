ANTHROPIC_API_KEY=sk-ant-...
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
POSTGRES_URL=

# Passwordless magic-link email (prospect sign-in). If RESEND_API_KEY is unset,
# the link is logged to the server console (and shown in the UI in dev).
RESEND_API_KEY=
EMAIL_FROM="Agentic SDLC <advisor@yourdomain.com>"

# Shown to prospects as the contact for data deletion / consent withdrawal.
PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com
