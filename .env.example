# Azure OpenAI (powers the AI advisor — narrate / reply / assess)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2024-10-21

# Required in production. Any long random string (e.g. `openssl rand -base64 32`).
AUTH_SECRET=

# Comma-separated emails allowed to sign in to the workspace. When set, this is
# the ONLY gate (so a personal Gmail works too). Leave empty to instead allow
# any non-consumer / professional email domain.
ALLOWED_EMAILS=nicolas@agentic-sdlc.it
BLOB_READ_WRITE_TOKEN=
POSTGRES_URL=

# Passwordless magic-link email (prospect sign-in). If RESEND_API_KEY is unset,
# the link is logged to the server console (and shown in the UI in dev).
RESEND_API_KEY=
EMAIL_FROM="Agentic SDLC <advisor@yourdomain.com>"

# Shown to prospects as the contact for data deletion / consent withdrawal.
PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com
